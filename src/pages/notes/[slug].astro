---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
---

<Layout title={`${note.data.title} — Иван Потылицын`} description={note.data.description}>

  <article class="note-page">
    <div class="container">
      <a href="/notes" class="back-link">← Все заметки</a>

      <header class="note-header">
        <time class="note-date">
          {note.data.date.toLocaleDateString('ru-RU', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
        <h1>{note.data.title}</h1>
        {note.data.description && (
          <p class="note-lead">{note.data.description}</p>
        )}
      </header>

      <div class="note-content">
        <Content />
      </div>

      <footer class="note-footer">
        <a href="/notes" class="back-link">← Все заметки</a>
      </footer>
    </div>
  </article>

</Layout>

<style>
  .note-page {
    padding: 64px 0 120px;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 48px;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .note-header {
    max-width: 720px;
    margin-bottom: 56px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 16px;
  }

  .note-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .note-lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .note-content {
    max-width: 720px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .note-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 48px 0 16px;
    letter-spacing: -0.02em;
  }

  .note-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 36px 0 12px;
  }

  .note-content :global(p) {
    margin-bottom: 24px;
    color: var(--color-text);
  }

  .note-content :global(ul),
  .note-content :global(ol) {
    margin: 0 0 24px 24px;
    color: var(--color-text-muted);
  }

  .note-content :global(li) {
    margin-bottom: 8px;
    line-height: 1.75;
  }

  .note-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .note-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--color-accent-dark);
  }

  .note-content :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    overflow-x: auto;
    margin: 28px 0;
  }

  .note-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  .note-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note-content :global(img) {
    width: 100%;
    margin: 32px 0;
    border: 1px solid var(--color-border);
  }

  .note-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 48px 0;
  }

  .note-footer {
    max-width: 720px;
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }
</style>
