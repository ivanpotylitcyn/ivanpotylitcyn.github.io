---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes');
const recentNotes = allNotes
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <div class="hero-badges">
            <span class="tag">МФТИ, Физтех</span>
            <span class="tag tag-gray">Долгопрудный</span>
          </div>
          <h1 class="hero-name">Иван<br/>Потылицын</h1>
          <p class="hero-bio">
            Инженер-исследователь и преподаватель. Руковожу командой,
            которая создаёт приборы для космических аппаратов, и учу студентов
            Физтеха делать то же самое. Снимаю фото и видео. Хожу в круизный яхтинг. Учусь музыке.
          </p>
          <div class="hero-links">
            <a href="https://t.me/potylitcyn" class="social-link" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248l-2.05 9.65c-.148.658-.543.818-1.1.508l-3.038-2.238-1.465 1.41c-.162.162-.298.298-.611.298l.218-3.088 5.622-5.082c.244-.218-.054-.338-.378-.12L6.25 14.362l-2.982-.93c-.648-.204-.66-.648.135-.96l11.65-4.492c.54-.196 1.012.12.51 1.268z"/></svg>
              Telegram
            </a>
            <a href="https://vk.com/potylitcynblog" class="social-link" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.862-.523-2.049-1.713-1.033-1.01-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.597v1.567c0 .427-.136.683-1.253.683-1.846 0-3.896-1.12-5.339-3.202C4.609 10.81 4 8.649 4 8.204c0-.254.102-.491.597-.491h1.744c.444 0 .613.203.785.677.866 2.506 2.318 4.7 2.913 4.7.223 0 .325-.102.325-.663V9.952c-.068-1.19-.697-1.29-.697-1.713 0-.203.163-.407.427-.407h2.747c.374 0 .508.203.508.641v3.452c0 .374.163.508.264.508.223 0 .406-.134 1.015-.743 1.575-1.77 2.7-4.492 2.7-4.492.149-.305.406-.587.851-.587h1.744c.527 0 .644.272.527.641-.22 1.016-2.352 4.03-2.352 4.03-.186.305-.254.44 0 .78.183.254.782.781 1.186 1.253.736.838 1.302 1.541 1.455 2.025.148.475-.091.714-.589.714z"/></svg>
              ВКонтакте
            </a>
            <a href="https://www.youtube.com/@potylitcyn" class="social-link" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
              YouTube
            </a>
            <a href="https://github.com/ivanpotylitcyn" class="social-link" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              GitHub
            </a>
            <a href="https://instagram.com/ivanpotylitcyn" class="social-link" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              Instagram
            </a>
          </div>
        </div>
        <div class="hero-photo">
          <img src="/ip.jpeg" alt="Иван Потылицын" class="hero-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="work" id="work">
    <div class="container">
      <span class="section-label">Работа</span>
      <h2 class="section-title">Чем я занимаюсь</h2>
      <div class="work-grid">

        <div class="work-card work-card--featured">
          <div class="work-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <div class="work-card-content">
            <span class="tag">Приборостроение</span>
            <h3>Космические приборы</h3>
            <p>
              Руковожу командой инженеров-исследователей в МФТИ, Физтех.
              Разрабатываем приборы для малых космических аппаратов:
              командно-телеметрические радиолинии, системы управления,
              бортовое программное обеспечение.
            </p>
            <a href="https://ant-lab.ru" class="work-link" target="_blank" rel="noopener">
              ant-lab.ru →
            </a>
          </div>
        </div>

        <div class="work-card">
          <div class="work-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
          </div>
          <div class="work-card-content">
            <span class="tag">Образование</span>
            <h3>Преподавание в Физтехе</h3>
            <p>
              Веду двухлетнюю программу подготовки инженеров-исследователей
              для первокурсников МФТИ. Студенты учатся проектировать
              реальные приборы и разрабатывать встроенное ПО.
            </p>
            <a href="mailto:potylitcyn@phystech.edu" class="work-link">
              potylitcyn@phystech.edu →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Hobbies -->
  <section class="hobbies" id="hobbies">
    <div class="container">
      <span class="section-label">Вне работы</span>
      <h2 class="section-title">Хобби</h2>
      <div class="hobbies-grid">

        <div class="hobby-card">
          <div class="hobby-image">
            <img src="/photo.jpeg" alt="Фото и видео" />
          </div>
          <div class="hobby-content">
            <h3>Фото и видео</h3>
            <p>
              Серьёзное увлечение, которое порой сложно отличить от работы.
              Снимаю людей, природу, экспедиции. Монтирую видео.
            </p>
            <a href="https://instagram.com/ivanpotylitcyn" class="hobby-link" target="_blank" rel="noopener">
              Instagram →
            </a>
          </div>
        </div>

        <div class="hobby-card">
          <div class="hobby-image">
            <img src="/yacht.jpeg" alt="Круизный яхтинг" />
          </div>
          <div class="hobby-content">
            <h3>Круизный яхтинг</h3>
            <p>
              Хожу под парусом в открытом море. Люблю длинные переходы,
              навигацию и жизнь на борту вдали от берега.
            </p>
          </div>
        </div>

        <div class="hobby-card">
          <div class="hobby-image">
            <img src="/music.jpeg" alt="Музыка" />
          </div>
          <div class="hobby-content">
            <h3>Музыка</h3>
            <p>
              Играю. Музыка — способ переключиться и побыть
              в другой системе координат.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Notes -->
  <section class="notes-section" id="notes">
    <div class="container">
      <div class="notes-header">
        <div>
          <span class="section-label">Мысли и наблюдения</span>
          <h2 class="section-title">Заметки</h2>
        </div>
        <a href="/notes" class="notes-all-link">Все заметки →</a>
      </div>

      {recentNotes.length > 0 ? (
        <div class="notes-list">
          {recentNotes.map(note => (
            <a href={`/notes/${note.slug}`} class="note-item">
              <div class="note-meta">
                <time class="note-date">
                  {note.data.date.toLocaleDateString('ru-RU', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>
              </div>
              <h3 class="note-title">{note.data.title}</h3>
              {note.data.description && (
                <p class="note-description">{note.data.description}</p>
              )}
            </a>
          ))}
        </div>
      ) : (
        <p class="notes-empty">Заметки скоро появятся.</p>
      )}

      <div class="follow-channels">
        <p class="follow-label">Следить за обновлениями:</p>
        <div class="follow-links">
          <a href="https://t.me/potylitcyn" class="follow-card" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248l-2.05 9.65c-.148.658-.543.818-1.1.508l-3.038-2.238-1.465 1.41c-.162.162-.298.298-.611.298l.218-3.088 5.622-5.082c.244-.218-.054-.338-.378-.12L6.25 14.362l-2.982-.93c-.648-.204-.66-.648.135-.96l11.65-4.492c.54-.196 1.012.12.51 1.268z"/></svg>
            <span>Telegram</span>
            <span class="follow-handle">@potylitcyn</span>
          </a>
          <a href="https://vk.com/potylitcynblog" class="follow-card" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.862-.523-2.049-1.713-1.033-1.01-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.597v1.567c0 .427-.136.683-1.253.683-1.846 0-3.896-1.12-5.339-3.202C4.609 10.81 4 8.649 4 8.204c0-.254.102-.491.597-.491h1.744c.444 0 .613.203.785.677.866 2.506 2.318 4.7 2.913 4.7.223 0 .325-.102.325-.663V9.952c-.068-1.19-.697-1.29-.697-1.713 0-.203.163-.407.427-.407h2.747c.374 0 .508.203.508.641v3.452c0 .374.163.508.264.508.223 0 .406-.134 1.015-.743 1.575-1.77 2.7-4.492 2.7-4.492.149-.305.406-.587.851-.587h1.744c.527 0 .644.272.527.641-.22 1.016-2.352 4.03-2.352 4.03-.186.305-.254.44 0 .78.183.254.782.781 1.186 1.253.736.838 1.302 1.541 1.455 2.025.148.475-.091.714-.589.714z"/></svg>
            <span>ВКонтакте</span>
            <span class="follow-handle">potylitcynblog</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contacts -->
  <section class="contacts" id="contacts">
    <div class="container">
      <span class="section-label">Связаться</span>
      <h2 class="section-title">Контакты</h2>
      <div class="contacts-inner">
        <div class="contacts-main">
          <a href="mailto:potylitcyn@phystech.edu" class="email-link">
            potylitcyn@phystech.edu
          </a>
          <p class="contacts-note">
            Пишите по любым вопросам: сотрудничество, образование, творчество или 
            совместные проекты.
          </p>
        </div>
        <div class="contacts-social">
          <a href="https://t.me/ivanpotylitcyn" class="contact-social-link" target="_blank" rel="noopener">Telegram</a>
          <a href="https://vk.com/ivanpotylitcyn" class="contact-social-link" target="_blank" rel="noopener">ВКонтакте</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    padding: 100px 0 96px;
    background:
      radial-gradient(ellipse 70% 60% at 70% 0%, rgba(2, 132, 199, 0.06) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 0% 100%, rgba(2, 132, 199, 0.04) 0%, transparent 50%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 64px;
    align-items: center;
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .hero-name {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.0;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
  }

  .hero-bio {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 540px;
    line-height: 1.75;
    margin-bottom: 40px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    background: var(--color-white);
  }

  .social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-light);
    text-decoration: none;
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    object-position: bottom;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    display: block;
  }

  /* Work */
  .work {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 48px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .work-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .work-card:hover {
    border-color: var(--color-border-blue);
    box-shadow: 0 4px 24px rgba(2, 132, 199, 0.08);
  }

  .work-card--featured {
    border-color: var(--color-border-blue);
    background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 60%);
  }

  .work-card-icon {
    color: var(--color-accent);
    width: 48px;
    height: 48px;
    background: var(--color-accent-light);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .work-card-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 8px 0 12px;
  }

  .work-card-content .tag {
    margin-bottom: 4px;
  }

  .work-card-content p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.75;
    margin-bottom: 16px;
  }

  .work-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.15s;
    margin-top: auto;
  }

  .work-link:hover {
    opacity: 0.75;
    text-decoration: none;
  }

  /* Hobbies */
  .hobbies {
    background: var(--color-white);
  }

  .hobbies-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .hobby-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }

  .hobby-card:hover {
    border-color: var(--color-border-blue);
    transform: translateY(-3px);
  }

  .hobby-image {
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .hobby-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
    transition: transform 0.4s ease;
  }

  .hobby-card:hover .hobby-image img {
    transform: scale(1.03);
  }

  .hobby-content {
    padding: 24px;
  }

  .hobby-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .hobby-content p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .hobby-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .hobby-link:hover {
    opacity: 0.75;
    text-decoration: none;
  }

  /* Notes section */
  .notes-section {
    background: var(--color-surface-blue);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .notes-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .notes-header .section-title {
    margin-bottom: 0;
  }

  .notes-all-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 4px;
  }

  .notes-all-link:hover {
    text-decoration: underline;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 48px;
  }

  .note-item {
