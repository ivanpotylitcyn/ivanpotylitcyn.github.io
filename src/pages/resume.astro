            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248l-2.05 9.65c-.148.658-.543.818-1.1.508l-3.038-2.238-1.465 1.41c-.162.162-.298.298-.611.298l.218-3.088 5.622-5.082c.244-.218-.054-.338-.378-.12L6.25 14.362l-2.982-.93c-.648-.204-.66-.648.135-.96l11.65-4.492c.54-.196 1.012.12.51 1.268z"/></svg>
